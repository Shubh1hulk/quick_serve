# QuickServe Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration:
# Leave blank to use hassle-free local SQLite database (quickserve.db in database/)
# Or provide your free cloud PostgreSQL connection string (Neon, Supabase, Render, Railway, AWS):
# Example Neon free tier: postgresql://quickserve_owner:password@ep-green-pond-12345.ap-southeast-1.aws.neon.tech/quickserve?sslmode=require
DATABASE_URL=
DB_SSL=true

# Authentication and payment configuration:
ADMIN_NAME=QuickServe Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-in-production
PAYMENT_PROVIDER=mock

# Leave empty to use mock payments locally. Add both values to enable Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR
